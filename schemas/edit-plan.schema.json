{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inova.local/schemas/edit-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "version", "target", "segments", "overlays", "captions", "approval"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^VID-[0-9]{4}-[0-9]{4,}$"},
    "version": {"type": "integer", "minimum": 1},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "width", "height", "fps", "duration_seconds"],
      "properties": {
        "format": {"enum": ["vertical", "horizontal"]},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "fps": {"enum": [24, 25, 30, 50, 60]}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "segments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_file", "in", "out", "purpose", "transcript_excerpt"],
        "properties": {
          "source_file": {"type": "string", "minLength": 1},
          "in": {"type": "number", "minimum": 0}, "out": {"type": "number", "exclusiveMinimum": 0},
          "purpose": {"enum": ["hook", "context", "development", "closing", "other"]},
          "transcript_excerpt": {"type": "string"}
        }
      }
    },
    "audio_segments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_file", "in", "out", "timeline_in", "timeline_out", "transcript_excerpt"],
        "properties": {
          "source_file": {"type": "string", "minLength": 1},
          "in": {"type": "number", "minimum": 0},
          "out": {"type": "number", "exclusiveMinimum": 0},
          "timeline_in": {"type": "number", "minimum": 0},
          "timeline_out": {"type": "number", "exclusiveMinimum": 0},
          "transcript_excerpt": {"type": "string"}
        }
      }
    },
    "overlays": {"type": "array", "items": {"type": "object"}},
    "captions": {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"type": "string"}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["pending", "approved", "changes_requested"]}}}
  }
}
