{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inova.local/schemas/transcript.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "version", "language", "source_sha256", "provider", "review", "segments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^VID-[0-9]{4}-[0-9]{4,}$"},
    "version": {"type": "integer", "minimum": 1},
    "language": {"const": "pt-BR"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "package_version", "model", "revision", "device", "compute_type"],
      "properties": {
        "name": {"type": "string"}, "model": {"type": "string"},
        "package_version": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]}, "device": {"type": "string"},
        "compute_type": {"type": "string"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewed_by", "reviewed_at"],
      "properties": {
        "status": {"enum": ["pending", "reviewed", "changes_requested"]},
        "reviewed_by": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "start", "end", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "text": {"type": "string"},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "words": {"type": "array", "items": {"$ref": "#/$defs/word"}}
        }
      }
    }
  },
  "$defs": {
    "word": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "text"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0},
        "text": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}
