{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inova.local/schemas/project.schema.json",
  "title": "Projeto audiovisual",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "title", "editorial", "status", "source", "people", "publication", "branding", "governance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^VID-[0-9]{4}-[0-9]{4,}$"},
    "title": {"type": "string"},
    "editorial": {"type": "string", "minLength": 1},
    "status": {"enum": ["received", "validated", "transcribed", "analyzed", "edit_planned", "draft_rendered", "under_review", "changes_requested", "approved", "final_rendered", "published", "archived", "quarantined"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "captured_at", "location", "operator", "sha256"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "location": {"type": ["string", "null"]},
        "operator": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "role", "institution", "image_authorization_status"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "institution": {"type": "string"},
          "image_authorization_status": {"enum": ["pending", "approved", "denied", "not_required"]}
        }
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["channels", "target_duration_seconds", "language"],
      "properties": {
        "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "target_duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "language": {"const": "pt-BR"}
      }
    },
    "branding": {
      "type": "object", "additionalProperties": false,
      "required": ["template_version", "logo_asset"],
      "properties": {
        "template_version": {"type": ["string", "null"]},
        "logo_asset": {"type": ["string", "null"]}
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["institutional_review_required", "legal_review_required", "transcript_reviewed", "approved_by", "approved_at"],
      "properties": {
        "institutional_review_required": {"type": "boolean"},
        "legal_review_required": {"type": "boolean"},
        "transcript_reviewed": {"type": "boolean"},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
