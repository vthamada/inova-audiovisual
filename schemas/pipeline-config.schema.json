{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inova.local/schemas/pipeline-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "network_policy", "workspace_root", "log", "tools", "tool_requirements", "transcription", "render", "approval"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "network_policy": {"const": "deny_by_default"},
    "workspace_root": {"type": "string", "minLength": 1},
    "log": {"type": "object", "additionalProperties": false, "required": ["level", "format"], "properties": {"level": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR"]}, "format": {"enum": ["human", "json"]}}},
    "tools": {"type": "object", "additionalProperties": false, "required": ["ffmpeg", "ffprobe", "node", "npm", "hyperframes"], "properties": {"ffmpeg": {"type": "string", "minLength": 1}, "ffprobe": {"type": "string", "minLength": 1}, "node": {"type": "string", "minLength": 1}, "npm": {"type": "string", "minLength": 1}, "hyperframes": {"type": "string", "minLength": 1}}},
    "tool_requirements": {"type": "object", "additionalProperties": false, "required": ["node_prefix", "hyperframes_version", "ffmpeg_prefix", "ffprobe_prefix"], "properties": {"node_prefix": {"type": "string"}, "hyperframes_version": {"type": "string"}, "ffmpeg_prefix": {"type": "string"}, "ffprobe_prefix": {"type": "string"}}},
    "transcription": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "device", "compute_type", "language", "local_files_only"], "properties": {"provider": {"type": "string"}, "model": {"type": "string"}, "device": {"type": "string"}, "compute_type": {"type": "string"}, "language": {"type": "string"}, "local_files_only": {"const": true}}},
    "render": {"type": "object", "additionalProperties": false, "required": ["draft_profile", "final_profile", "fps", "workers"], "properties": {"draft_profile": {"type": "string"}, "final_profile": {"type": "string"}, "fps": {"type": "integer", "minimum": 1}, "workers": {"type": "integer", "minimum": 1, "maximum": 8}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["require_transcript_review", "require_image_authorization", "require_licensed_assets", "allow_bypass"], "properties": {"require_transcript_review": {"const": true}, "require_image_authorization": {"const": true}, "require_licensed_assets": {"const": true}, "allow_bypass": {"const": false}}}
  }
}
